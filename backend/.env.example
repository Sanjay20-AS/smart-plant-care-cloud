# Backend Configuration

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-key

# Database (SQLAlchemy)
# For PostgreSQL (Supabase):
# DATABASE_URL=postgresql://postgres:your-password@db.supabase.co:5432/postgres
# For local development (SQLite):
DATABASE_URL=sqlite:///./smartplant.db

# API
API_PREFIX=/api/v1
API_TITLE=Smart Plant Care API
API_VERSION=1.0.0

# Logging
LOG_LEVEL=INFO

# Authentication
# Set to True to require authentication on protected endpoints
REQUIRE_AUTH=False

